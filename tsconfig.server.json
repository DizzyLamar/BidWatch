{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "types": ["node"]
  },
  "include": ["backend", "server.ts", "src/platform.ts"],
  "exclude": ["backend/realtime.ts", "backend/realtime-subscribers.ts"]
}
